{
  "manifest_version": 3,
  "name": "RCCR",
  "version": "1.1.0",
  "author": "cyrene zhang",
  "description": "recurse center conference room. dm @cyrene-zhang if you run into any issues or have any questions / suggestions!",
  "browser_specific_settings": {
    "gecko": {
      "id": "conference-room@recurse.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "idle",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "media.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
